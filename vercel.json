{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/auth.js": {
      "maxDuration": 60
    },
    "api/hero.js": {
      "includeFiles": "private/hero-motos.html",
      "maxDuration": 15
    },
    "api/xiaomi.js": {
      "includeFiles": "private/xiaomi*{,/**}",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/xiaomi",
      "destination": "/index.html"
    },
    {
      "source": "/hero",
      "destination": "/index.html"
    }
  ]
}
